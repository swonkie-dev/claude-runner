# Copiar para .env e preencher. O .env está no .gitignore e nunca é versionado.
# Todos os valores específicos da tua instalação vivem aqui, não no repositório.

# ---------------------------------------------------------- autenticação ----
# Token de subscrição. Gera numa sessão interativa com `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternativa: faturação por uso, sem limites de janela.
# Define apenas UMA das duas. Se ambas estiverem definidas a API key ganha.
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- API ----
# Token que o orquestrador envia em Authorization: Bearer <token>.
# Gera com: openssl rand -hex 32
RUNNER_TOKEN=

# Sessões em paralelo. Com subscrição o recurso escasso NÃO é o CPU, é a janela
# de utilização: quatro sessões em paralelo queimam-na quatro vezes mais
# depressa. Mantém baixo. Com API key podes subir para cores - 2.
MAX_CONCURRENCY=2

# Vazio = o Claude usa o modelo por omissão. Aceita alias: opus, sonnet, fable.
DEFAULT_MODEL=
# low | medium | high | xhigh | max. Vazio = o default do CLI.
DEFAULT_EFFORT=
# Travão de custo por job, em dólares. Só faz sentido com API key: em subscrição
# não há custo por token, e o travão real é o DEFAULT_TIMEOUT_MS.
DEFAULT_MAX_BUDGET_USD=0
# 1 hora
DEFAULT_TIMEOUT_MS=3600000

# Ao bater no limite de utilização, reagenda o job para a hora do reset em vez
# de o falhar, retomando a sessão. Ver a secção correspondente do README.
RESCHEDULE_ON_RATE_LIMIT=true
MAX_RESCHEDULES=3

# Aborta o job se algum MCP declarado não ligar. Sem isto o Claude corre sem
# essas ferramentas e devolve um resultado plausível mas sem capacidades, sem
# erro nenhum. Deixa ligado.
FAIL_ON_MCP_ERROR=true

# ----------------------------------------------------------------- docker ----
# Nome desta instância. Aparece no container, no projeto e nos volumes, e é o
# nome pelo qual o orquestrador lhe chama (claude-runner-<instance>:8080).
# Para várias marcas ou clientes: uma pasta e um .env por instância.
INSTANCE=default

# Rede docker onde vive o orquestrador, para os containers se verem pelo nome.
#   docker network ls
N8N_NETWORK=n8n

# GID do grupo dono de /dev/dri/renderD128 no host, para a GPU integrada.
#   getent group render | cut -d: -f3
# Em algumas distribuições o grupo chama-se "video" em vez de "render".
RENDER_GID=render

# Tecto, não reserva. Ajusta ao que a máquina tem e ao que já lá corre.
MEMORY_LIMIT=16g
CPU_LIMIT=8

# ------------------------------------------------------------------ build ----
# LibreOffice pesa ~450MB. Só o queres se converteres docx/xlsx/pptx.
WITH_LIBREOFFICE=true
# faster-whisper para transcrição, ~250MB, corre em CPU.
WITH_WHISPER=true
# Browser próprio, atual e isolado. "chromium firefox webkit" para os três.
# Vazio = sem browser local; nesse caso configura o BROWSERLESS_WS abaixo e lê
# a secção Browser do README primeiro.
PLAYWRIGHT_BROWSERS=chromium

# ------------------------------------------------------------- browserless ----
# Só usado se PLAYWRIGHT_BROWSERS estiver vazio. O ?timeout= sobrepõe-se ao
# CONNECTION_TIMEOUT do browserless, que por omissão é baixo demais para um
# agente navegar e iterar.
BROWSERLESS_WS=ws://browserless:3000?timeout=600000

# ---------------------------------------------------------------- MCP URLs ----
# O container monta o mcp.json a partir daqui. Um servidor sem os valores
# preenchidos e simplesmente omitido.
SWONKIE_MCP_URL=
TEAMS_MCP_URL=
TEAMS_AUTHORIZATION=
HIEVENTS_MCP_URL=
HIEVENTS_AUTHORIZATION=
POSTHOG_API_KEY=
N8N_API_URL=
N8N_API_KEY=

# Service token do Cloudflare Access, para os endpoints que estejam atras dele.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Hosts aos quais os CALLBACKS devem levar o service token acima. Sem isto o
# token nao e enviado a lado nenhum, para nao acabar em maos de terceiros.
# Tipicamente o host do teu orquestrador, se estiver atras de Cloudflare Access.
# Sintoma de faltar: o callback leva 302 para a pagina de login e o workflow
# fica preso a espera para sempre.
CF_ACCESS_HOSTS=

# ------------------------------------------------------------------- git ----
# PAT fine-grained com acesso APENAS aos repositórios que este agente deve
# tocar, com Contents: read/write e Pull requests: write. Não uses um token
# clássico com acesso a tudo, nem o teu token pessoal: queres poder revogar
# isto sozinho e distinguir no histórico o que foi o agente do que foste tu.
GH_TOKEN=
GIT_AUTHOR_NAME=Claude Runner
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=Claude Runner
GIT_COMMITTER_EMAIL=
